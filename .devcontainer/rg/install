#!/bin/bash
set -e

# rg version
RG_VERSION="15.1.0"

# Detect architecture
ARCH=$(uname -m)
if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
  ARCH_SUFFIX="aarch64"
  C_RUNTIME="gnu"
elif [ "$ARCH" = "x86_64" ] || [ "$ARCH" = "amd64" ]; then
  ARCH_SUFFIX="x86_64"
  C_RUNTIME="musl"
else
  echo "Unsupported architecture: $ARCH"
  exit 1
fi

DOWNLOAD_URL="https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/ripgrep-${RG_VERSION}-${ARCH_SUFFIX}-unknown-linux-${C_RUNTIME}.tar.gz"

CACHE_DIR="/persist/shared/devcontainer-downloads"
ARTIFACT="$(basename "$DOWNLOAD_URL")"
CACHED="$CACHE_DIR/$ARTIFACT"

mkdir -p "$CACHE_DIR"
if [ ! -f "$CACHED" ]; then
  echo "Downloading $ARTIFACT from $DOWNLOAD_URL"
  curl -fL "$DOWNLOAD_URL" -o "$CACHED.partial"
  mv "$CACHED.partial" "$CACHED"
else
  echo "Using cached $ARTIFACT"
fi

TMP_DIR="/tmp/rg_install"
mkdir -p "$TMP_DIR"
tar -xz -C "$TMP_DIR" -f "$CACHED"
sudo mv "$TMP_DIR/ripgrep-${RG_VERSION}-${ARCH_SUFFIX}-unknown-linux-${C_RUNTIME}/rg" /usr/local/bin/rg
sudo chmod +x /usr/local/bin/rg
rm -rf "$TMP_DIR"

echo "rg v${RG_VERSION} installed successfully"
