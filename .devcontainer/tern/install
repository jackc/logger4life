#!/bin/bash
set -e

# tern version
TERN_VERSION="2.3.5"

# Detect architecture
ARCH=$(uname -m)
if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
  ARCH_SUFFIX="arm64"
elif [ "$ARCH" = "x86_64" ] || [ "$ARCH" = "amd64" ]; then
  ARCH_SUFFIX="amd64"
else
  echo "Unsupported architecture: $ARCH"
  exit 1
fi

DOWNLOAD_URL="https://github.com/jackc/tern/releases/download/v${TERN_VERSION}/tern_${TERN_VERSION}_linux_${ARCH_SUFFIX}.tar.gz"

CACHE_DIR="/persist/shared/devcontainer-downloads"
ARTIFACT="$(basename "$DOWNLOAD_URL")"
CACHED="$CACHE_DIR/$ARTIFACT"

mkdir -p "$CACHE_DIR"
if [ ! -f "$CACHED" ]; then
  echo "Downloading $ARTIFACT from $DOWNLOAD_URL"
  curl -fL "$DOWNLOAD_URL" -o "$CACHED.partial"
  mv "$CACHED.partial" "$CACHED"
else
  echo "Using cached $ARTIFACT"
fi

TMP_DIR="/tmp/tern_install"
mkdir -p "$TMP_DIR"
tar -xz -C "$TMP_DIR" -f "$CACHED"
sudo mv "$TMP_DIR/tern" /usr/local/bin/
sudo chmod +x /usr/local/bin/tern
rm -rf "$TMP_DIR"

echo "tern v${TERN_VERSION} installed successfully"
