#!/bin/bash
set -e

# watchexec version
WATCHEXEC_VERSION="2.3.3"

# Detect architecture
ARCH=$(uname -m)
if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
  ARCH_SUFFIX="aarch64"
elif [ "$ARCH" = "x86_64" ] || [ "$ARCH" = "amd64" ]; then
  ARCH_SUFFIX="x86_64"
else
  echo "Unsupported architecture: $ARCH"
  exit 1
fi

DOWNLOAD_URL="https://github.com/watchexec/watchexec/releases/download/v${WATCHEXEC_VERSION}/watchexec-${WATCHEXEC_VERSION}-${ARCH_SUFFIX}-unknown-linux-gnu.deb"

CACHE_DIR="/persist/shared/devcontainer-downloads"
ARTIFACT="$(basename "$DOWNLOAD_URL")"
CACHED="$CACHE_DIR/$ARTIFACT"

mkdir -p "$CACHE_DIR"
if [ ! -f "$CACHED" ]; then
  echo "Downloading $ARTIFACT from $DOWNLOAD_URL"
  curl -fL "$DOWNLOAD_URL" -o "$CACHED.partial"
  mv "$CACHED.partial" "$CACHED"
else
  echo "Using cached $ARTIFACT"
fi

sudo dpkg -i "$CACHED"

echo "watchexec v${WATCHEXEC_VERSION} installed successfully"
