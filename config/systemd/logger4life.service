[Unit]
Description=Logger4Life
ConditionPathExists=/apps/logger4life/current
After=network.target

[Service]
Type=simple
User=logger4life
Group=logger4life

Restart=on-failure
RestartSec=30

WorkingDirectory=/apps/logger4life/current
EnvironmentFile=/apps/logger4life/shared/logger4life.env
ExecStart=/apps/logger4life/current/bin/logger4life server

[Install]
WantedBy=multi-user.target
