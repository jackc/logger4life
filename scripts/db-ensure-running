#!/usr/bin/env bash
#
# Start this worktree's PostgreSQL cluster if it is not already running, and
# leave it running. Used by the tasks that need a database but not the whole
# development stack -- the test suites, psql, migrations.

set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. scripts/dev-env.sh

if pg_running; then
	exit 0
fi

if [ ! -f "$PGDATA/PG_VERSION" ]; then
	exec scripts/db-init
fi

echo "==> starting PostgreSQL on port $PGPORT" >&2
pg_start
