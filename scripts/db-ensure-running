#!/usr/bin/env bash
#
# Start this worktree's PostgreSQL cluster if it is not already running, and
# leave it running. Used by the tasks that need a database but not the whole
# development stack -- the test suites, psql, migrations.

set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. scripts/dev-env.sh

if [ ! -f "$PGDATA/PG_VERSION" ]; then
	# db-init stops a cluster that it had to start temporarily. Return here and
	# start it again so this script still fulfills its leave-running contract on
	# a checkout's very first database task.
	scripts/db-init
fi

if pg_running; then
	exit 0
fi

pg_start
