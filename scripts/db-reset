#!/usr/bin/env bash
#
# Drop this worktree's databases and rebuild them from the migrations. The
# cluster itself is kept; deleting .dev/postgres is how to discard that.

set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. scripts/dev-env.sh

if [ ! -f "$PGDATA/PG_VERSION" ]; then
	exec scripts/db-init
fi

pg_running || pg_start

for database in "$PGDATABASE" logger4life_test; do
	echo "==> dropping $database"
	dropdb --force --if-exists --maintenance-db=postgres "$database"
done

exec scripts/db-init
