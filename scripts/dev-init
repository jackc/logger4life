#!/usr/bin/env bash
#
# Prepare this worktree to run `mise run dev`: allocate ports, install
# dependencies, and build the PostgreSQL cluster. Idempotent, and identical on
# macOS and inside the dev container.

set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. scripts/dev-env.sh

echo "==> installing dependencies"
bundle install --quiet
npm install --silent
npx playwright install chromium

scripts/db-init

echo
scripts/devports show
echo
echo "Run 'mise run dev' to start the stack."
