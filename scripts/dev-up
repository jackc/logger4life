#!/usr/bin/env bash
#
# Start this worktree's development stack under process-compose.
#
# Ports are re-checked and re-allocated here, before anything is started and
# before the environment is read, so that services never inherit a stale
# allocation.

set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

scripts/devports ensure
. scripts/dev-env.sh


scripts/devports show
echo

exec process-compose up --ordered-shutdown "$@"
