#!/usr/bin/env ruby
# frozen_string_literal: true

# devports -- per-worktree TCP port allocation.
#
# Every worktree of this repository is an independent development instance:
# its own PostgreSQL cluster, its own backend, its own Vite. They therefore
# need their own ports. Rather than a global registry, a worktree draws a
# random block of ports once, persists it in .dev/ports.env, and reuses it.
#
# Two dormant worktrees may hold the same block; that is harmless. The
# operating system is the registry of the allocations that currently matter,
# so `ensure` re-draws when something else is already holding a port.
#
#   devports init     allocate a block unless one already exists
#   devports ensure   allocate, or re-allocate if any port is taken
#   devports show     print the block in human-readable form
#   devports env      print the block as KEY=value lines
#   devports path     print the location of ports.env

require "socket"

ROOT = File.expand_path("..", __dir__)
PORTS_FILE = File.join(ROOT, ".dev", "ports.env")

# A block is 20 ports. The first eight are assigned; the rest are held in
# reserve so a new service can be added without moving anything.
BLOCK_SIZE = 20
LOWEST_BASE = 10_000
HIGHEST_BASE = 45_000 - BLOCK_SIZE

# Offsets from PORT_BASE. Never renumber these -- existing worktrees have
# their base persisted, and a renumber would silently move their services.
OFFSETS = {
  "BACKEND_PORT" => 1,
  "VITE_PORT" => 2,
  "PGPORT" => 3,
  # PC_PORT_NUM is the variable process-compose itself reads, so `process-compose
  # process list` targets this worktree's instance with no flags.
  "PC_PORT_NUM" => 4,
  "DEBUG_PORT" => 5,
  "TEST_BACKEND_PORT" => 6,
  "TEST_VITE_PORT" => 7,
  "PLAYWRIGHT_REPORT_PORT" => 8,
}.freeze

# Ports that must actually be free before the stack can start. DEBUG_PORT is
# not included: nothing binds it unless a debugger is attached by hand.
REQUIRED = (OFFSETS.keys - ["DEBUG_PORT"]).freeze

# Services bind to the loopback address; the URLs handed to humans, agents,
# and browsers use "localhost" because WebAuthn rejects an IP address as a
# relying party ID, and passkeys are part of the app.
BIND_HOST = "127.0.0.1"
URL_HOST = "localhost"
PGUSER = "postgres"
DEV_DATABASE = "logger4life_dev"
TEST_DATABASE = "logger4life_test"

def available?(port)
  server = TCPServer.new(BIND_HOST, port)
  server.close
  true
rescue Errno::EADDRINUSE, Errno::EACCES
  false
end

def ports_for(base)
  OFFSETS.transform_values { |offset| base + offset }
end

def block_available?(base)
  REQUIRED.all? { |name| available?(base + OFFSETS.fetch(name)) }
end

def taken_ports(base)
  REQUIRED.reject { |name| available?(base + OFFSETS.fetch(name)) }
          .map { |name| "#{name}=#{base + OFFSETS.fetch(name)}" }
end

def draw_base
  200.times do
    base = rand(LOWEST_BASE..HIGHEST_BASE)
    return base if block_available?(base)
  end
  abort "devports: could not find #{BLOCK_SIZE} free ports after 200 attempts"
end

def read_allocation
  return nil unless File.exist?(PORTS_FILE)

  values = {}
  File.foreach(PORTS_FILE) do |line|
    next if line.start_with?("#") || !line.include?("=")

    key, value = line.chomp.split("=", 2)
    values[key] = value
  end
  base = values["PORT_BASE"]
  base&.match?(/\A\d+\z/) ? base.to_i : nil
end

def render(base)
  ports = ports_for(base)
  lines = ["# Generated by scripts/devports. Do not edit; run `mise run dev:ports:reset`.", "", "PORT_BASE=#{base}"]
  ports.each { |name, port| lines << "#{name}=#{port}" }
  lines += [
    "",
    "BIND_ADDRESS=#{BIND_HOST}",
    "BACKEND_URL=http://#{URL_HOST}:#{ports.fetch('BACKEND_PORT')}",
    "VITE_URL=http://#{URL_HOST}:#{ports.fetch('VITE_PORT')}",
    "TEST_BACKEND_URL=http://#{URL_HOST}:#{ports.fetch('TEST_BACKEND_PORT')}",
    "TEST_VITE_URL=http://#{URL_HOST}:#{ports.fetch('TEST_VITE_PORT')}",
    "",
    "PGHOST=#{BIND_HOST}",
    "DATABASE_URL=postgres://#{PGUSER}@#{BIND_HOST}:#{ports.fetch('PGPORT')}/#{DEV_DATABASE}",
    "TEST_DATABASE_URL=postgres://#{PGUSER}@#{BIND_HOST}:#{ports.fetch('PGPORT')}/#{TEST_DATABASE}",
    "",
  ]
  lines.join("\n")
end

def write(base)
  require "fileutils"
  FileUtils.mkdir_p(File.dirname(PORTS_FILE))
  tmp = "#{PORTS_FILE}.tmp"
  File.write(tmp, render(base))
  File.rename(tmp, PORTS_FILE)
  base
end

def allocate(reason)
  base = draw_base
  write(base)
  warn "devports: #{reason}; allocated ports #{base + 1}-#{base + BLOCK_SIZE - 1}"
  base
end

def current_or_allocate(reason)
  base = read_allocation
  return allocate(reason) if base.nil?

  # Keep the file in step with this script: the block is defined by PORT_BASE,
  # so everything derived from it can be re-rendered without moving anything.
  write(base) if File.read(PORTS_FILE) != render(base)
  base
end

def show(base)
  ports = ports_for(base)
  puts "#{File.basename(ROOT)} -- port block #{base}"
  puts
  puts format("  %-16s %s", "Frontend:", "http://#{URL_HOST}:#{ports.fetch('VITE_PORT')}")
  puts format("  %-16s %s", "Backend:", "http://#{URL_HOST}:#{ports.fetch('BACKEND_PORT')}")
  puts format("  %-16s %s", "PostgreSQL:", "#{BIND_HOST}:#{ports.fetch('PGPORT')}")
  puts format("  %-16s %s", "process-compose:", "#{BIND_HOST}:#{ports.fetch('PC_PORT_NUM')}")
  puts
  puts format("  %-16s %s", "Test backend:", "http://#{URL_HOST}:#{ports.fetch('TEST_BACKEND_PORT')}")
  puts format("  %-16s %s", "Test frontend:", "http://#{URL_HOST}:#{ports.fetch('TEST_VITE_PORT')}")
  puts format("  %-16s %s", "Test report:", "http://#{URL_HOST}:#{ports.fetch('PLAYWRIGHT_REPORT_PORT')}")
end

case ARGV[0]
when "init"
  current_or_allocate("no allocation yet")
when "ensure"
  base = current_or_allocate("no allocation yet")
  taken = taken_ports(base)
  allocate("ports in use by something else (#{taken.join(', ')})") unless taken.empty?
when "show"
  base = read_allocation or abort "devports: no allocation yet; run `mise run dev:init`"
  show(base)
when "env"
  base = read_allocation or abort "devports: no allocation yet; run `mise run dev:init`"
  print render(base)
when "path"
  puts PORTS_FILE
when "reset"
  allocate("reset requested")
else
  abort "usage: devports {init|ensure|show|env|path|reset}"
end
