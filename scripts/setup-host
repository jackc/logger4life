#!/usr/bin/env bash
# Install host prerequisites only. Project tools and checkout initialization
# remain explicit, separate steps documented in README.md.

set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

case "$(uname -s)" in
    Darwin)
        scripts/setup-host-macos
        ;;
    Linux)
        scripts/setup-host-ubuntu
        ;;
    *)
        echo "setup-host: unsupported operating system: $(uname -s)" >&2
        exit 1
        ;;
esac

echo
echo "Host setup complete. No project tools or checkout state were initialized."
