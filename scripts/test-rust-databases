#!/usr/bin/env bash
# Run the native backend matrix using freshly migrated disposable databases.
set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. scripts/dev-env.sh

matrix_db=""
matrix_log="$(mktemp)"
cleanup() {
    if [ -n "$matrix_db" ]; then
        dropdb --if-exists --force "$matrix_db"
    fi
    rm -f "$matrix_log"
}
trap cleanup EXIT

for backend in postgresql both; do
    matrix_db="logger4life_rust_matrix_${backend}_$$"
    createdb "$matrix_db"
    matrix_url="postgres://$PGUSER@$PGHOST:$PGPORT/$matrix_db"
    if ! tern migrate --conn-string "$matrix_url" -c "$TERN_CONFIG" -m "$TERN_MIGRATIONS" >"$matrix_log" 2>&1; then
        cat "$matrix_log" >&2
        exit 1
    fi
    echo "Running Rust contracts with $backend"
    TEST_DATABASE_BACKEND="$backend" \
    TEST_DATABASE_URL="$matrix_url" \
        cargo test --locked -- --test-threads=1
    dropdb --force "$matrix_db"
    matrix_db=""
done
